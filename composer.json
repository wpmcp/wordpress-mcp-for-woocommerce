{
  "name": "wpmcp/wpmcp",
  "description": "AI builds and edits your WordPress site, and physically can't wreck it.",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1",
    "wordpress/mcp-adapter": "^0.6.1" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "wp-phpunit/wp-phpunit": "^6.9",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "brianium/paratest": "^6.11",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "slevomat/coding-standard": "^8.15"
  },
  "autoload": {
    "psr-4": {
      "WPMCP\\Modules\\": ["src/Modules/", "pro/modules/"],
      "WPMCP\\": ["src/", "pro/src/"]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPMCP\\Tests\\Free\\": ["tests/free/", "pro/tests/free/"],
      "WPMCP\\Tests\\Pro\\": ["tests/pro/", "pro/tests/pro/"],
      "WPMCP\\Compliance\\": "tools/compliance/src/",
      "WPMCP\\Lint\\": "tools/lint/src/",
      "WPMCP\\Registry\\": "tools/registry/src/",
      "WPMCP\\PHPStan\\": "tools/phpstan/src/",
      "WPMCP\\Tests\\Kernel\\": "tests/kernel/",
      "WPMCP\\Tests\\Modules\\": "tests/modules/"
    },
    "classmap": ["tests/kernel/Fixture/"]
  },
  "scripts": {
    "test": "phpunit",
    "test:free": "phpunit --testsuite free",
    "test:pro": "phpunit --testsuite pro",
    "test:local": "bash bin/test-local.sh",
    "test:coverage": "phpunit --coverage-clover coverage/clover.xml --coverage-text",
    "drift:check": "php bin/check-ability-drift.php --strict",
    "manifest:regenerate": "WPMCP_REGENERATE_MANIFEST=1 bash bin/test-local.sh -- --filter AbilityManifestTest",
    "lint": ["@lint:psr12", "@lint:wpcs"],
    "lint:psr12": "phpcs -q",
    "lint:wpcs": "php bin/check-phpcs-baseline.php",
    "lint:wpcs:update-baseline": "php bin/check-phpcs-baseline.php --update",
    "compliance": "php tools/compliance/bin/compliance.php --profile=distribution",
    "compliance:wporg": "php tools/compliance/bin/compliance.php --profile=wporg-free --no-artifact",
    "check:flavors": "bash bin/check-flavors.sh",
    "build:wporg": "bash scripts/build-wporg-release.sh",
    "build:woo": "bash scripts/build-woo-release.sh",
    "registry:build": "@php bin/build-registry.php",
    "registry:check": "@php bin/build-registry.php --check --all-flavors",
    "standard": "bash bin/standard.sh",
    "standard:diff": "bash bin/standard.sh --diff=origin/main",
    "make:module": "@php bin/make-module.php",
    "test:kernel": "phpunit -c phpunit-fast.xml.dist --testsuite kernel,modules",
    "test:module": "@php bin/test-module.php",
    "post-autoload-dump": "[ ! -f bin/build-registry.php ] || php bin/build-registry.php --auto --quiet"
  },
  "config": {
    "allow-plugins": { "*": true },
    "platform": { "php": "8.1.0" }
  }
}
